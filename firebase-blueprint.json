{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and plan information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "team"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Processed meeting transcript and AI results",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "summary": { "type": "string" },
        "sentiment": { "type": "string" },
        "followUpEmail": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Task": {
      "title": "Task",
      "description": "Individual action item extracted from a meeting",
      "type": "object",
      "properties": {
        "meetingId": { "type": "string" },
        "userId": { "type": "string" },
        "task": { "type": "string" },
        "owner": { "type": "string" },
        "deadline": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Meeting summaries and transcripts"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Extracted action items"
    }
  }
}
